# Copie este arquivo para ".env" e preencha com valores reais.
# Em produção, o ".env" fica SOMENTE no servidor — nunca é versionado no Git.

# --- Banco de dados ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://usuario:senha@postgres_local:5432/nome_do_banco

# --- Autenticação da API ---
SECRET_KEY=
ALGORITHM=HS256
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Portas / URLs ---
BACKEND_PORT=8000
API_HOST=backend
VITE_API_URL=/api/v1

# --- Ambiente ---
DEBUG=false
LOG_LEVEL=info

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=recanto-minidogs
EVOLUTION_DB_NAME=evolution

# --- Produção (Oracle VM + HTTPS automático via Caddy) ---
# Domínio que aponta para o IP público da VM (ex.: pet.seudominio.com ou
# seunome.duckdns.org). Obrigatório no docker-compose.prod.yml.
DOMAIN=
# Origens extras permitidas no CORS (vírgula). Normalmente vazio em produção,
# pois frontend e API são servidos na mesma origem.
CORS_ORIGINS=
